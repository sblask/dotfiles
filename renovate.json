{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>[.0-9]+)$",
      "managerFilePatterns": [
        "/^.github/workflows/pre-commit\\.yml$/",
        "/^ansible/appimages\\.yml$/",
        "/^ansible/asdf\\.yml$/",
        "/^ansible/utils\\.yml$/",
        "/^ansible/utils-rust\\.yml$/"
      ],
      "matchStrings": [
        "v?(?<currentValue>[.0-9]+)  # renovate: (?<depName>[^ \\n]+)",
        "version: (?<currentValue>[.0-9]+)  # renovate: (?<depName>[^ \\n]+)"
      ]
    }
  ],
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "aquasecurity/tfsec",
    "aquasecurity/trivy",
    "hashicorp/terraform",
    "hashicorp/terraform-ls",
    "terraform-doc",
    "terraform-linters/tflint"
  ],
  "ignorePaths": [
    "ansible/includes/requirements-poetry-1.8.5.txt"
  ],
  "minimumReleaseAge": "1 week",
  "packageRules": [
    {
      "automerge": true,
      "automergeType": "branch",
      "groupName": "actions",
      "matchPackageNames": [
        "actions/*"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "groupName": "ansible",
      "matchPackageNames": [
        "ansible-core",
        "ansible-lint",
        "ansible/ansible-lint"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "yamllint",
      "matchPackageNames": [
        "adrienverge/yamllint",
        "yamllint"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "matchPackageNames": [
        "pip"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "automerge": true,
      "automergeType": "branch",
      "extends": [
        "schedule:monthly"
      ],
      "matchPackageNames": [
        "JohnnyMorganz/StyLua",
        "Kampfkarren/selene",
        "aws-cli",
        "cli/cli",
        "editorconfig-checker/editorconfig-checker",
        "https://github.com/aws/aws-cli.git",
        "igorshubovych/markdownlint-cli",
        "ipython",
        "junegunn/fzf",
        "pre-commit/pre-commit",
        "pyright",
        "renovatebot/pre-commit-hooks"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/requirements-.+\\.txt/"
    ]
  },
  "prConcurrentLimit": 0,
  "prHourlyLimit": 1,
  "pre-commit": {
    "enabled": true
  },
  "rebaseWhen": "auto"
}
